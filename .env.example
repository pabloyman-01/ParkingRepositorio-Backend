# ─────────────────────────────────────────────────────────────
# El gateway NO usa base de datos: consume la API Central de CondoSaaS
# por HTTP. Por defecto (sin este .env) ya apunta a la API desplegada en
# Render, así que arranca SOLO, sin levantar CondoSaaS ni una BD.
# Crea un .env (copiando este archivo) solo si quieres sobreescribir algo.
# ─────────────────────────────────────────────────────────────

# URL de la API Central de CondoSaaS (por defecto usa la de Render):
EXTERNAL_API_BASE_URL=https://parking-system-backend-0chy.onrender.com

# Puerto local del gateway (por defecto 8080):
PORT=8080

# JWT del puente de autenticación (opcional; ya tienen valores por defecto):
JWT_SECRET=your-256-bit-secret-key-change-in-production
JWT_EXPIRATION_MS=28800000
JWT_REFRESH_EXPIRATION_MS=604800000
